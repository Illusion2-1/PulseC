{
  "name": "pulsec-web",
  "version": "1.0.0",
  "scripts": {
    "build": "svelte-kit sync && vite build",
    "check": "svelte-kit sync && svelte-check --fail-on-warnings",
    "format": "prettier --write \"src/**/*.{ts,js,svelte}\" \"test/**/*.ts\" \"*.config.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,svelte}\" \"test/**/*.ts\" \"*.config.{js,ts}\"",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src test"
  },
  "type": "module",
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "22.20.5",
    "oxlint": "1.92.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "~6.0.0",
    "vite": "^8.3.8",
    "vitest": "5.1.0"
  },
  "private": true,
  "dependencies": {
    "katex": "^0.19.1",
    "lowlight": "^3.3.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}

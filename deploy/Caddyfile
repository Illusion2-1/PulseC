# Enable WebTransport in your main Caddyfile's existing global options block:
#   servers {
#       webtransport
#   }
# Import this site from that Caddyfile, replacing chat.example.org with your domain.
chat.example.org {
	reverse_proxy https://127.0.0.1:8443 {
		header_up Host {http.request.hostport}
		transport http {
			versions 3
			# The generated certificate is accepted only on this fixed numeric loopback hop.
			tls_insecure_skip_verify
		}
	}
}

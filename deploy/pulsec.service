[Unit]
Description=PulseC anonymous WebTransport relay
After=network.target

[Service]
User=pulsec
Group=pulsec
ExecStart=/opt/pulsec/current/pulsec -addr :8443 -cert /etc/pulsec/fullchain.pem -key /etc/pulsec/privkey.pem -stats-interval 1m
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
UMask=0077

[Install]
WantedBy=multi-user.target

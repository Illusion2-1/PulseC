#!/bin/sh
# Publish one Certbot lineage and notify its consumers. Linux, GNU coreutils and flock.
set -eu
if [ "$#" -lt 2 ]; then
    echo "usage: certbot-deploy TLS_DIRECTORY TLS_GID [COMMAND [ARG...]]" >&2
    exit 2
fi
: "${RENEWED_LINEAGE:?Certbot must supply the certificate lineage}"
dest=$1
gid=$2
shift 2
umask 077

mkdir -p -- "$dest"
exec 9<"$dest"
flock -x 9
old=$(readlink -- "$dest/current" || :)
case "$old" in
    pair-a) next=pair-b ;;
    pair-b) next=pair-a ;;
    '')
        [ ! -e "$dest/current" ] || { echo "unexpected certificate layout" >&2; exit 1; }
        next=pair-a ;;
    *) echo "unexpected certificate layout" >&2; exit 1 ;;
esac

# An operator may already have placed regular PEM files here. Never replace them.
for name in fullchain.pem privkey.pem; do
    if [ -e "$dest/$name" ] || [ -L "$dest/$name" ]; then
        [ "$(readlink -- "$dest/$name")" = "current/$name" ] || {
            echo "use a dedicated certificate directory" >&2; exit 1;
        }
    fi
done

# Snapshot before validation. A bad or partially copied renewal leaves both slots intact.
stage=$(mktemp -d -- "$dest/.certbot.XXXXXXXX")
trap 'rm -rf -- "$stage"' EXIT
install -m 0640 -g "$gid" -- "$RENEWED_LINEAGE/fullchain.pem" "$stage/fullchain.pem"
install -m 0640 -g "$gid" -- "$RENEWED_LINEAGE/privkey.pem" "$stage/privkey.pem"
openssl x509 -in "$stage/fullchain.pem" -checkend 0 -noout
openssl x509 -in "$stage/fullchain.pem" -pubkey -noout > "$stage/cert.pub"
openssl pkey -in "$stage/privkey.pem" -passin pass: -pubout > "$stage/key.pub"
cmp -s "$stage/cert.pub" "$stage/key.pub" || { echo "certificate and key differ" >&2; exit 1; }

# Replay of the same renewal can retry a failed notification without rotating slots.
if [ -n "$old" ] && cmp -s "$stage/fullchain.pem" "$dest/current/fullchain.pem" &&
        cmp -s "$stage/privkey.pem" "$dest/current/privkey.pem"; then
    next=$old
fi

[ ! -L "$dest/$next" ] || { echo "unexpected certificate slot" >&2; exit 1; }
install -d -m 0750 -g "$gid" -- "$dest" "$dest/$next"
for name in fullchain.pem privkey.pem; do
    mv -Tf -- "$stage/$name" "$dest/$next/$name"
    if [ ! -L "$dest/$name" ]; then ln -s -- "current/$name" "$dest/$name"; fi
done
ln -s -- "$next" "$stage/current.next"
mv -Tf -- "$stage/current.next" "$dest/current"

# Keep the valid pair on disk even if its consumers need a separate retry.
# Children must not inherit the publication lock, including services they start.
if [ "$#" -gt 0 ]; then "$@" 9<&-; fi

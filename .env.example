# Default: bind only to the host's loopback. Use 0.0.0.0 for public IPv4.
PULSEC_BIND_IP=127.0.0.1
# Port used by the base/local configuration. The public overlays use 80 and 443.
PULSEC_PORT=8443
PULSEC_CERT_DIR=./certs
# Numeric group permitted to read the private key and traverse this directory.
PULSEC_TLS_GID=65532
# Source checkout: leave these defaults. Native release archives set their own .env.
PULSEC_TARGET=source
PULSEC_BINARY=dist/release/pulsec
# Public overlays: set the variables for your chosen deployment in .env.
# PULSEC_DOMAIN=chat.example.org
# compose.direct.yaml: host directory where Certbot writes HTTP-01 files
# PULSEC_WEBROOT=/var/lib/pulsec/acme
# compose.caddy.yaml: public CA certificate that authenticates the private upstream
# PULSEC_UPSTREAM_CA=/etc/pulsec/origin-ca.crt

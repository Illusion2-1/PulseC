# Base mode defaults to loopback. Direct mode publishes on public IPv4.
# PULSEC_BIND_IP=127.0.0.1
# Port used by the base/local configuration. Direct mode uses 80 and 443.
PULSEC_PORT=8443
PULSEC_CERT_DIR=./certs
# Numeric group permitted to read the private key and traverse this directory.
PULSEC_TLS_GID=65532
# PULSEC_IMAGE=illusionn21/pulsec:v1.0.0
# Use never for a locally built or offline image.
# PULSEC_PULL_POLICY=never
# Build options used only with --build. Native archives set their own .env.
PULSEC_TARGET=source
PULSEC_BINARY=dist/release/pulsec
# Direct deployment: public hostname for the bundled Certbot service.
# PULSEC_DOMAIN=chat.example.org
# PULSEC_ACME_EMAIL=admin@example.org
# Set this for an existing Caddy using compose.local.yaml.
# PULSEC_BEHIND_PROXY=true
